# .env.example — copy to .env and fill in. SAFE TO COMMIT: contains no secrets.
#
#   cp .env.example .env
#   $EDITOR .env
#
# NEVER put a real key in this file. It is committed on purpose so the next
# person can see which variables exist.

# ── Answer generation (optional) ───────────────────────────────────────────
# RaggyEditor is a WORKING app without any key: semantic search, ranking and
# highlighting all run locally. A key only turns on the "Ask" (generated,
# cited answer) path. When it is absent we degrade to retrieval-only — we do
# not fake an answer.
#
# ⚠️ DeepSeek has NO /embeddings endpoint, so embeddings always stay local
# (sentence-transformers or the offline LSA fallback). DeepSeek IS
# OpenAI-compatible for /chat/completions, so it works here unchanged.
#
# DeepSeek:
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   OPENAI_MODEL=deepseek-chat
# OpenAI:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ── Embeddings (optional, local) ───────────────────────────────────────────
# "auto"  -> use sentence-transformers if importable, else offline LSA (default)
# "neural"-> require a real encoder (fails loudly if unavailable)
# "lsa"   -> always use the offline TF-IDF + SVD stand-in (hermetic, no download)
RAGGY_ENCODER=auto
RAGGY_ENCODER_MODEL=BAAI/bge-small-en-v1.5

# ── Sidecar ────────────────────────────────────────────────────────────────
RAGGY_HOST=127.0.0.1
RAGGY_PORT=8791
